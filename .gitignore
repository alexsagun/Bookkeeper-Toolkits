node_modules
dist
dist-ssr

# Local env files (never commit your API key)
.env
.env.local
.env.*.local
# Shadow-project credentials for the DB/RLS suite (npm run test:db)
.env.test

# Vite rewrites its config to a timestamped ESM file on every dev-server start and
# does not always clean up after itself, so these accumulate in the repo root. They
# are transient build output, and a `git add -A` will otherwise stage them.
vite.config.js.timestamp-*

# Logs
*.log
build_output.txt
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Stray asset: api/ is serverless functions only, and vercel.json serves
# /api/* as-is (its SPA rewrite excludes them), so anything dropped here gets a
# public URL. Images belong in public/.
api/*.jpeg
api/*.jpg
api/*.png

# Machine-local Claude Code permissions. This was previously ignored ONLY by the
# developer's global gitignore, so the protection did not travel to another clone.
.claude/settings.local.json
