# Required ONLY for the AI-powered features (ProAdvisor Chat, Coach Alex, CPA AI,
# resume/proposal/SOP/diagnostic generators, bank-feed AI, statement converter, etc.).
# Everything else (calculators, checklists, Chart of Accounts, templates) runs without it.
#
# 1. Get a key at https://console.anthropic.com/
# 2. Copy this file to `.env` and paste your key below
# 3. Run `npm run dev`
#
# The key is used ONLY by the Vite dev proxy (vite.config.js) and is never sent to the browser.

ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Supabase (user authentication — signup / login). Required for the auth gate.
# ---------------------------------------------------------------------------
# 1. Create a free project at https://supabase.com/
# 2. Project Settings -> API -> copy the "Project URL" and the "anon public" key
# 3. Paste them below in `.env`, then run `npm run dev`
#
# NOTE: unlike ANTHROPIC_API_KEY, these MUST be `VITE_`-prefixed so Vite exposes
# them to the browser at build time. The anon key is PUBLIC by design — it is safe
# in the client bundle. Real security is enforced by Supabase Row Level Security
# (RLS) policies on the database, NOT by hiding this key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Temporary admin-approval gate (new signups need admin approval) — see
# ADMIN_APPROVAL_SETUP.md. The feature is ON by default once you run the SQL
# migration (db/2026-06-29-user-approval.sql). These vars are all OPTIONAL.
# ---------------------------------------------------------------------------
# Turn the whole gate OFF later (open access) without a code change. Default is ON;
# set to false (and rebuild) to disable. VITE_-prefixed because the client reads it.
VITE_REQUIRE_ADMIN_APPROVAL=

# Enrollment / payment paywall (unpaid non-admins are held on the Enrollment Paywall
# until an admin verifies their payment) — see ENROLLMENT_SETUP.md. ON by default once
# you run the SQL migrations (db/2026-07-04-enrollment.sql + subscription-lifecycle).
# Set to false (and rebuild) to disable the paywall. VITE_-prefixed because the client
# reads it. RLS remains the real boundary regardless of this flag.
VITE_REQUIRE_ENROLLMENT=

# ---------------------------------------------------------------------------
# Notification EMAILS (optional) — powers BOTH the admin-approval approve/reject
# emails (api/notify-access.js) AND the enrollment/payment emails
# (api/notify-enrollment.js: "new enrollment submitted" admin alert, student
# approve/reject/expired, and the admin "Test email" button). Server-only.
# ---------------------------------------------------------------------------
# ⚠️ IMPORTANT — these run as VERCEL SERVERLESS FUNCTIONS. `npm run dev` (Vite) does
#    NOT run them, so email can only be tested on a Vercel deploy (Preview or Prod),
#    NEVER on the local dev server. Set these in Vercel → Settings → Environment
#    Variables (Production + Preview), then Redeploy. Without them, everything still
#    works — the app just shows "email not configured".
#
# ⚠️ Resend only DELIVERS from an allowed sender: verify a domain in Resend and use it
#    in RESEND_FROM (recommended — reaches admins AND students), or use the test sender
#    "onboarding@resend.dev" which only delivers to your own Resend-account email.
#    The API key must belong to the account that owns the verified domain.
#
# Server-only — do NOT add a VITE_ prefix and never expose these in the browser.
#   RESEND_API_KEY      — your Resend key (re_…); may reuse the one from the Supabase SMTP setup
#                         (but it must still be added HERE in Vercel — Supabase's copy is separate)
#   RESEND_FROM         — a verified sender, e.g. "Toolkits by Alex <noreply@yourdomain.com>"
#                         ★ The recovery differs by branch: a failed INVITATION leaves the row at
#                           status='invited' and Team & Roles offers "Resend invitation". A CONFIRMED
#                           existing account is promoted straight to 'active' with no token at all, so
#                           its failed email is a missed NOTIFICATION — there is nothing pending, and
#                           no Resend control. Tell that person directly.
#   NOTIFY_ADMIN_EMAIL  — (optional) where the "new enrollment submitted" alert lands; if unset,
#                         falls back to payment_settings.notify_email, then to RESEND_FROM's address.
#                         Since #50 it is ALSO the fallback Reply-To + visible support contact on
#                         staff invitations — but that chain is SHORTER and ends here:
#                         payment_settings.notify_email, then NOTIFY_ADMIN_EMAIL, then NOTHING.
#                         It deliberately does NOT fall through to RESEND_FROM the way the
#                         enrollment alert does, because RESEND_FROM is typically a no-reply
#                         mailbox: promising "contact our team at <noreply@…>" and setting a
#                         Reply-To nobody reads is worse than omitting both, which is what
#                         happens when neither address is configured.
#   APP_URL             — absolute origin, e.g. https://toolkits.alexsagun.com (defaults to the
#                         request host). Used for the "Review in Enrollments" button AND, since #49,
#                         to build the staff invitation link https://<origin>/staff/invitation.
#
# ★ SINCE #49 THE STAFF INVITATION ALSO GOES THROUGH RESEND. It used to be sent by Supabase's own
#   mailer with the stock "Invite user" template; it is now built in this repo and sent here. With
#   RESEND_* unset the staff role is still assigned and the invitation is still valid — the email
#   simply is not sent, the row is flagged invite_status='failed', and Team & Roles offers
#   "Resend invitation". Check with: GET /api/admin/staff -> { hasResend, hasAppUrl }.
RESEND_API_KEY=
RESEND_FROM=
NOTIFY_ADMIN_EMAIL=
APP_URL=

# ---------------------------------------------------------------------------
# Legacy student migration emails (optional, #67/#68) — Student Imports' activation and
# sign-in emails and the two "onboarded" emails (api/admin/student-imports.js,
# api/notify-enrollment.js). Server-only — never VITE_. All three may stay unset.
# ---------------------------------------------------------------------------
# ★ FROM AND REPLY-TO ARE TWO SETTINGS, AND MOVING ONE NEVER MOVES THE OTHER.
#   Resend only sends From a domain verified in THIS account, and a verified subdomain does
#   not cover its parent (toolkits.alexsagun.com being verified does not let mail go From
#   @alexsagun.com — that was #67's 403). Replies need no verification at all.
#   MIGRATION_EMAIL_FROM   — the From header, used exactly as given, e.g.
#                            "Toolkits by Alex Support <support@alexsagun.com>" once that domain
#                            is verified in Resend. Unset: "Toolkits by Alex Support
#                            <support@<the domain of RESEND_FROM>>" — the domain every other
#                            email in the app already sends from.
#   MIGRATION_REPLY_TO     — where students' replies go, and the contact every migration email
#                            prints (footer, "write to …", sign-off). Unset: support@alexsagun.com,
#                            a monitored mailbox. Setting MIGRATION_EMAIL_FROM does NOT change it.
#                            ★ IT MOVES TOGETHER WITH THE APP. A migrated student held on the
#                            "membership pending" screen is told to write to a BUILD-TIME
#                            address, MIGRATION_SUPPORT_EMAIL in src/BookkeeperPro.jsx
#                            (support@alexsagun.com) — the browser cannot read this setting.
#                            Leave this unset, or set it to that same address; to move the
#                            mailbox, change that constant in the same deploy, or the emails
#                            and the screen will name two different inboxes.
#   MIGRATION_DAILY_EMAIL_CAP — the provider's daily allowance, shown against a run's email count
#                            in the activation confirmation. Unset: 100 (Resend's free plan).
#                            Advisory only: a 429 from Resend is what actually pauses a run.
# Check with Student Imports → "Send test email": it names the From, the Reply-To, the
# exact refusal (401 key, 403 domain, 422 malformed, 429 limit) and whether Resend's click
# tracking is on for the sending domain — it must be OFF, or every claim link (and its
# one-time token) passes through Resend's redirect host.
MIGRATION_EMAIL_FROM=
MIGRATION_REPLY_TO=
MIGRATION_DAILY_EMAIL_CAP=

# ---------------------------------------------------------------------------
# ElevenLabs voice assistant (optional) — "Toolkits Siri — AI Voice Guide & Course
# Trainer", the in-app voice widget.
# See docs/ai/voice-agent-setup.md for the full setup (agent, client tools, knowledge).
# ---------------------------------------------------------------------------
# Server-only — do NOT add a VITE_ prefix; the key must never reach the browser. Used by
# api/elevenlabs/signed-url.js (Vercel + the Vite dev middleware — this DOES work under
# `npm run dev`) and by `npm run ai:knowledge:push` / `npm run ai:provision`.
# Unset = the voice widget simply never appears (soft-off switch, no error).
# For Vercel: set both in Production + Preview, then Redeploy.
#
# One-command setup (create the agent + its 7 client tools + 4 webhook tools + attach the knowledge base):
#   set ELEVENLABS_API_KEY below, then `npm run ai:provision` — it prints the agent id to
#   paste into ELEVENLABS_AGENT_ID. `npm run ai:provision -- --dry-run` prints the plan
#   without writing anything.
#   ★ NOT BUILT YET (docs/ai/voice-agent-setup.md §3a): the read-only `--verify-only` check —
#   the script REFUSES that flag and changes nothing — and the preflight that would refuse to
#   provision while the trainer below is not ready. That preflight is NOT enforced today, so
#   confirm the trainer reports configured:true yourself before you provision.
#   ELEVENLABS_API_KEY          — xi-api-key from https://elevenlabs.io (Profile → API keys)
#   ELEVENLABS_AGENT_ID         — the Conversational-AI agent id (Agents → your agent; set it
#                                 to the id `ai:provision` prints, or leave blank to create one)
#   ELEVENLABS_SERVER_LOCATION  — (optional) 'us' (default), 'eu-residency', 'in-residency',
#                                 or a full https base URL override
#   ELEVENLABS_VOICE_ID         — (optional) voice override for `ai:provision`; unset = an
#                                 existing agent keeps its dashboard voice
#   ELEVENLABS_AGENT_LLM        — (optional) LLM override for `ai:provision`; unset = an
#                                 existing agent keeps its dashboard LLM
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_SERVER_LOCATION=

# ---------------------------------------------------------------------------
# AI Course Trainer (optional) — lets the voice assistant TEACH the Supabase-hosted
# courses with server-side, fail-closed entitlement checks on every request.
# Full setup: COURSE_AI_TRAINER_SETUP.md (migration #27, the trainer-embed Edge
# Function, ElevenLabs webhook tools via `npm run ai:provision`).
# ---------------------------------------------------------------------------
# Server-only — do NOT add a VITE_ prefix. ≥32 random characters (e.g. `openssl rand
# -hex 32`). Signs the short-lived (15-min) trainer session tokens that ride the
# ElevenLabs `secret__trainer_token` dynamic variable into webhook tool HEADERS only.
#
# ★ REQUIRED TO PROVISION THE TRAINER WEBHOOK TOOLS. `npm run ai:provision` refuses to
#   create or attach them unless this is set HERE (NO_TRAINER_SECRET) AND the DEPLOYED
#   app's GET /api/elevenlabs/trainer reports configured:true (TRAINER_NOT_CONFIGURED).
#   A value in this file alone never satisfies the second check. So:
#     1. set it in Vercel → Settings → Environment Variables, in BOTH Production AND
#        Preview, with the SAME value (the agent's webhook tools always call the
#        production APP_URL, so a token minted by a Preview deployment is verified by
#        Production);
#     2. REDEPLOY — env changes reach only new deployments;
#     3. confirm GET https://toolkits.alexsagun.com/api/elevenlabs/trainer
#        → {"ok":true,"configured":true};
#     4. then provision.
#
# Unset in a deployment = the 4 trainer webhook tools answer "not configured"; the rest
# of the voice widget is unaffected. The trainer also REUSES: SUPABASE_SECRET_KEY
# (service-role retrieval AFTER auth), ELEVENLABS_API_KEY (Scribe transcription), and
# APP_URL (the origin the ElevenLabs webhook tools call — required for `ai:provision`;
# unset is FATAL, NO_APP_URL, because continuing would detach the trainer tools).
#
# APP_URL does not have to live in this file on a dev machine — pass it inline for the
# one run instead:
#   bash:        APP_URL=https://toolkits.alexsagun.com npm run ai:provision
#   PowerShell:  $env:APP_URL = 'https://toolkits.alexsagun.com'; npm run ai:provision
TRAINER_TOKEN_SECRET=

# ---------------------------------------------------------------------------
# Admin Student Import (server-only) — the Thinkific → Toolkit migration tool.
# Powers api/admin/student-imports.js (Vercel AND `npm run dev` via the vite dev
# middleware). See STUDENT_IMPORT_SETUP.md for the full walkthrough.
# ---------------------------------------------------------------------------
# ⚠️ SERVICE-ROLE SECRET — the MOST sensitive key in the app. It can create/modify
#    any user and bypass RLS. It is used ONLY inside api/admin/student-imports.js,
#    which verifies the caller is an admin BEFORE using it. NEVER add a VITE_ prefix,
#    never expose it in the browser, and never return/log it. Rotate it if leaked.
#
#   SUPABASE_SECRET_KEY        — Supabase → Project Settings → API → "service_role" secret
#                                (new projects may label it "secret key"). This is the
#                                canonical var. A legacy SUPABASE_SERVICE_ROLE_KEY is
#                                accepted as a fallback if SUPABASE_SECRET_KEY is unset.
#   SUPABASE_SERVICE_ROLE_KEY  — (optional legacy fallback for SUPABASE_SECRET_KEY)
#
# The import endpoint also REUSES: VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY (auth
# checks, already set above), RESEND_API_KEY (to email the one-time claim link — the
# link is emailed then discarded, never stored), RESEND_FROM (its DOMAIN is the default
# migration sender's; see MIGRATION_EMAIL_FROM above), and APP_URL (the origin of the
# first-party /activate-account link — the token rides in its #fragment, so no Supabase
# Redirect-URL entry is needed; required on every Vercel deployment, Preview included).
# For Vercel: set SUPABASE_SECRET_KEY in Production + Preview.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Supabase MANAGEMENT API token (developer machine only) — powers the repo's
# database TOOLING, not the app. See db/README.md + docs/db/shadow-project.md.
# ---------------------------------------------------------------------------
# Nothing in src/ or api/ reads this. Four npm scripts do, and every one of them
# exits immediately with "SUPABASE_ACCESS_TOKEN not found in .env" when it is unset:
#
#   npm run db:audit          scripts/audit-db.mjs — READ-ONLY audit of the LIVE
#                             project. Diffs db/*.sql against public.schema_migrations
#                             AND verifies the objects each migration promised really
#                             exist. This is the answer to "are my migrations applied?"
#                             — the Dashboard's SQL-Editor tab count is not.
#   npm run db:shadow:apply   scripts/apply-db-files.mjs — applies repo SQL to the
#   npm run db:shadow:verify  disposable SHADOW project (bootstrap parity check).
#   npm run test:db           the 42-test RLS/entitlement suite.
#
# The shadow scripts can never touch production: scripts/_shadow.mjs refuses a
# .env.test that names the live project ref (it TRUNCATEs tables).
#
# Create one at Supabase Dashboard → Account → Access Tokens (starts with `sbp_`).
#
# ⚠️ This is a PERSONAL, ACCOUNT-WIDE token — it reaches every project in your org
#    through https://api.supabase.com, and SQL sent through it runs as the `postgres`
#    superuser, which BYPASSES RLS. Treat it like a root password; rotate if leaked.
#
# ⚠️ NOT interchangeable with SUPABASE_SECRET_KEY above. That is a per-project
#    service-role key used by api/admin/* at runtime and cannot drive the Management
#    API; this token cannot replace it either. Both are server-only — never VITE_.
SUPABASE_ACCESS_TOKEN=
