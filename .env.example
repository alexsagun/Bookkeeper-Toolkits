# Required ONLY for the AI-powered features (ProAdvisor Chat, Coach Alex, CPA AI,
# resume/proposal/SOP/diagnostic generators, bank-feed AI, statement converter, etc.).
# Everything else (calculators, checklists, Chart of Accounts, templates) runs without it.
#
# 1. Get a key at https://console.anthropic.com/
# 2. Copy this file to `.env` and paste your key below
# 3. Run `npm run dev`
#
# The key is used ONLY by the Vite dev proxy (vite.config.js) and is never sent to the browser.

ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Supabase (user authentication — signup / login). Required for the auth gate.
# ---------------------------------------------------------------------------
# 1. Create a free project at https://supabase.com/
# 2. Project Settings -> API -> copy the "Project URL" and the "anon public" key
# 3. Paste them below in `.env`, then run `npm run dev`
#
# NOTE: unlike ANTHROPIC_API_KEY, these MUST be `VITE_`-prefixed so Vite exposes
# them to the browser at build time. The anon key is PUBLIC by design — it is safe
# in the client bundle. Real security is enforced by Supabase Row Level Security
# (RLS) policies on the database, NOT by hiding this key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Temporary admin-approval gate (new signups need admin approval) — see
# ADMIN_APPROVAL_SETUP.md. The feature is ON by default once you run the SQL
# migration (db/2026-06-29-user-approval.sql). These vars are all OPTIONAL.
# ---------------------------------------------------------------------------
# Turn the whole gate OFF later (open access) without a code change. Default is ON;
# set to false (and rebuild) to disable. VITE_-prefixed because the client reads it.
VITE_REQUIRE_ADMIN_APPROVAL=

# Enrollment / payment paywall (unpaid non-admins are held on the Enrollment Paywall
# until an admin verifies their payment) — see ENROLLMENT_SETUP.md. ON by default once
# you run the SQL migrations (db/2026-07-04-enrollment.sql + subscription-lifecycle).
# Set to false (and rebuild) to disable the paywall. VITE_-prefixed because the client
# reads it. RLS remains the real boundary regardless of this flag.
VITE_REQUIRE_ENROLLMENT=

# ---------------------------------------------------------------------------
# Notification EMAILS (optional) — powers BOTH the admin-approval approve/reject
# emails (api/notify-access.js) AND the enrollment/payment emails
# (api/notify-enrollment.js: "new enrollment submitted" admin alert, student
# approve/reject/expired, and the admin "Test email" button). Server-only.
# ---------------------------------------------------------------------------
# ⚠️ IMPORTANT — these run as VERCEL SERVERLESS FUNCTIONS. `npm run dev` (Vite) does
#    NOT run them, so email can only be tested on a Vercel deploy (Preview or Prod),
#    NEVER on the local dev server. Set these in Vercel → Settings → Environment
#    Variables (Production + Preview), then Redeploy. Without them, everything still
#    works — the app just shows "email not configured".
#
# ⚠️ Resend only DELIVERS from an allowed sender: verify a domain in Resend and use it
#    in RESEND_FROM (recommended — reaches admins AND students), or use the test sender
#    "onboarding@resend.dev" which only delivers to your own Resend-account email.
#    The API key must belong to the account that owns the verified domain.
#
# Server-only — do NOT add a VITE_ prefix and never expose these in the browser.
#   RESEND_API_KEY      — your Resend key (re_…); may reuse the one from the Supabase SMTP setup
#                         (but it must still be added HERE in Vercel — Supabase's copy is separate)
#   RESEND_FROM         — a verified sender, e.g. "Toolkits by Alex <noreply@yourdomain.com>"
#   NOTIFY_ADMIN_EMAIL  — (optional) where the "new enrollment submitted" alert lands; if unset,
#                         falls back to payment_settings.notify_email, then to RESEND_FROM's address
#   APP_URL             — (optional) absolute origin for the "Review in Enrollments" button,
#                         e.g. https://toolkits.alexsagun.com (defaults to the request host)
RESEND_API_KEY=
RESEND_FROM=
NOTIFY_ADMIN_EMAIL=
APP_URL=

# ---------------------------------------------------------------------------
# ElevenLabs voice assistant (optional) — the in-app "Toolkits Guide" voice widget.
# See docs/ai/voice-agent-setup.md for the full setup (agent, client tools, knowledge).
# ---------------------------------------------------------------------------
# Server-only — do NOT add a VITE_ prefix; the key must never reach the browser. Used by
# api/elevenlabs/signed-url.js (Vercel + the Vite dev middleware — unlike the notify
# functions, this DOES work under `npm run dev`) and by `npm run ai:knowledge:push` /
# `npm run ai:provision`.
# Unset = the voice widget simply never appears (soft-off switch, no error).
# For Vercel: set both in Production + Preview, then Redeploy.
#
# One-command setup (create the agent + its 7 client tools + 4 webhook tools + attach the knowledge base):
#   set ELEVENLABS_API_KEY below, then `npm run ai:provision` — it prints the agent id to
#   paste into ELEVENLABS_AGENT_ID. `node scripts/provision-voice-agent.mjs --dry-run`
#   previews every API call without a key. See docs/ai/voice-agent-setup.md §3a.
#   ELEVENLABS_API_KEY          — xi-api-key from https://elevenlabs.io (Profile → API keys)
#   ELEVENLABS_AGENT_ID         — the Conversational-AI agent id (Agents → your agent; set it
#                                 to the id `ai:provision` prints, or leave blank to create one)
#   ELEVENLABS_SERVER_LOCATION  — (optional) 'us' (default), 'eu-residency', 'in-residency',
#                                 or a full https base URL override
#   ELEVENLABS_VOICE_ID         — (optional) agent voice id for `ai:provision` (default: Rachel)
#   ELEVENLABS_AGENT_LLM        — (optional) agent LLM for `ai:provision` (default: gpt-4o-mini)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_SERVER_LOCATION=

# ---------------------------------------------------------------------------
# AI Course Trainer (optional) — lets the voice assistant TEACH the Supabase-hosted
# courses with server-side, fail-closed entitlement checks on every request.
# Full setup: COURSE_AI_TRAINER_SETUP.md (migration #27, the trainer-embed Edge
# Function, ElevenLabs webhook tools via `npm run ai:provision`).
# ---------------------------------------------------------------------------
# Server-only — do NOT add a VITE_ prefix. ≥32 random characters (e.g. `openssl rand
# -hex 32`). Signs the short-lived (15-min) trainer session tokens that ride the
# ElevenLabs `secret__trainer_token` dynamic variable into webhook tool HEADERS only.
# Unset = the 4 trainer webhook tools answer "not configured"; the rest of the voice
# widget is unaffected. The trainer also REUSES: SUPABASE_SECRET_KEY (service-role
# retrieval AFTER auth), ELEVENLABS_API_KEY (Scribe transcription), and APP_URL (the
# origin the ElevenLabs webhook tools call — required for `ai:provision` to create them).
TRAINER_TOKEN_SECRET=

# ---------------------------------------------------------------------------
# Admin Student Import (server-only) — the Thinkific → Toolkit migration tool.
# Powers api/admin/student-imports.js (Vercel AND `npm run dev` via the vite dev
# middleware). See STUDENT_IMPORT_SETUP.md for the full walkthrough.
# ---------------------------------------------------------------------------
# ⚠️ SERVICE-ROLE SECRET — the MOST sensitive key in the app. It can create/modify
#    any user and bypass RLS. It is used ONLY inside api/admin/student-imports.js,
#    which verifies the caller is an admin BEFORE using it. NEVER add a VITE_ prefix,
#    never expose it in the browser, and never return/log it. Rotate it if leaked.
#
#   SUPABASE_SECRET_KEY        — Supabase → Project Settings → API → "service_role" secret
#                                (new projects may label it "secret key"). This is the
#                                canonical var. A legacy SUPABASE_SERVICE_ROLE_KEY is
#                                accepted as a fallback if SUPABASE_SECRET_KEY is unset.
#   SUPABASE_SERVICE_ROLE_KEY  — (optional legacy fallback for SUPABASE_SECRET_KEY)
#
# The import endpoint also REUSES: VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY (auth
# checks, already set above), RESEND_API_KEY / RESEND_FROM (to email the one-time
# set-password invite link — the link is emailed then discarded, never stored), and
# APP_URL (the redirect origin for the /welcome/set-password onboarding screen —
# add "${APP_URL}/welcome/set-password" to Supabase → Auth → URL Configuration →
# Redirect URLs). For Vercel: set SUPABASE_SECRET_KEY in Production + Preview.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
